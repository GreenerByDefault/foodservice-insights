{
  "$comment": "The worker parent <-> child contract. Neither side reads this file at runtime: both copy it into their own constants and assert equality in a unit test. See contract/README.md.",
  "invocation": {
    "module": "worker_child",
    "positionalArguments": ["runDirectory"],
    "workingDirectory": "work",
    "environmentVariables": ["PATH", "HOME", "LANG", "TZ", "OPENAI_API_KEY"]
  },
  "runDirectory": {
    "manifest": "input/run.json",
    "inputCsv": "input/input.csv",
    "progress": "output/progress.json",
    "result": "output/result.json",
    "failure": "output/failure.json",
    "telemetry": "output/telemetry.json",
    "resultFilesDirectory": "output/files",
    "workDirectory": "work",
    "directoriesCreatedByParent": ["input", "output", "output/files", "work"]
  },
  "inputCsv": {
    "columns": ["product", "date", "weight"],
    "dateFormat": "YYYY-MM-DD"
  },
  "resultFiles": {
    "pdf": "report.pdf",
    "xlsx": "report.xlsx"
  },
  "reportEnums": {
    "countsBasis": ["people", "meals"],
    "unitSystem": ["lb", "kg"]
  },
  "telemetryEnums": {
    "llmOperation": ["clean", "match"],
    "stage": ["read", "categorize", "report", "pdf", "xlsx"],
    "qualityCheck": [
      "outlier_line_items",
      "per_product_weight_bounds",
      "month_over_month_total_volatility",
      "diner_meal_count_reasonableness",
      "missing_internal_months",
      "date_distribution"
    ],
    "diagnosticStatus": ["success", "info", "warning", "error"]
  },
  "exitCodes": {
    "wroteResult": 0,
    "wroteFailure": 1,
    "usageError": 2
  },
  "failureReasonClaimants": {
    "child_crashed": "parent",
    "contract_violation": "either",
    "hard_timeout": "parent",
    "hung": "parent",
    "infrastructure": "parent",
    "unknown": "either",
    "upstream_api": "child",
    "abandoned": "parent",
    "shut_down": "parent",
    "unusable_data": "child"
  }
}
