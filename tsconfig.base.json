{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "esnext",
    // Node resolution, because bundler resolution would accept an extensionless relative import
    // that Node then rejects at runtime. apps/web is unaffected: `$app/tsconfig`, which it extends
    // after this file, sets bundler resolution.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["esnext"],
    "types": [],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,

    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "rewriteRelativeImportExtensions": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "noEmit": true
  }

  // No baseUrl/paths here: TypeScript doesn't merge `paths` across an extends
  // chain, and this would clobber SvelteKit's generated $lib/$app/types entries.
}
