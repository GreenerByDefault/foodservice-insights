# Copy to `.env`, which is gitignored. Values here are local-only. Anything secret is left
# blank for you to fill in. See ARCHITECTURE.md § Secrets management.
#
# This points at the dev stack, supabase-dev/. The test stack has its own committed file,
# `.env.test` — see the README on starting the databases.

DB_CONNECTION_STRING=postgresql://postgres:postgres@127.0.0.1:55322/postgres

# Supabase Storage, through its S3 API. The port is the `[api]` one from config.toml. The key and
# secret are the same on every machine: the Supabase CLI uses these locally for every project.
S3_ENDPOINT=http://127.0.0.1:55321/storage/v1/s3
S3_REGION=local
S3_ACCESS_KEY_ID=625729a08b95bf1b7ff351a663f3a23c
S3_SECRET_ACCESS_KEY=850181e4652dd023b7a98c58ae0d2d34bd487ee0cc3254aed6eda37307425907
S3_BUCKET=files

# Email. Read at http://localhost:55324.
EMAIL_TRANSPORT=mailpit
EMAIL_ENDPOINT=http://127.0.0.1:55324
EMAIL_FROM="Foodservice Insights <noreply@foodservice-insights.test>"
EMAIL_GBD_ADDRESS=gbd@foodservice-insights.test

# The origin every link in an email is built against.
SITE_URL=http://localhost:5173
