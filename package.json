{
  "name": "gbd-foodservice-insights",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11.18.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check": "turbo run check",
    "test:unit": "turbo run test:unit",
    "test:e2e": "turbo run test:e2e",
    "test:screenshots": "turbo run test:screenshots",
    "screenshots:update": "turbo run screenshots:update",
    "test": "pnpm run test:unit && pnpm run test:e2e && pnpm run test:screenshots",
    "lint": "biome ci --error-on-warnings .",
    "fmt": "biome check --write .",
    "migrate": "turbo run migrate",
    "seed:identity": "turbo run seed:identity",
    "seed:reports": "turbo run seed:reports",
    "truncate": "turbo run truncate",
    "db:gen-types": "turbo run gen-types"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "turbo": "2.10.9",
    "typescript": "catalog:"
  }
}
