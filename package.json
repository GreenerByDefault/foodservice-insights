{
  "name": "foodservice-insights",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11.18.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check": "turbo run check",
    "test:unit": "turbo run test:unit",
    "test:e2e": "turbo run test:e2e",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "lint": "biome ci .",
    "fmt": "biome check --write .",
    "db:migrate": "pnpm --filter @gbd/db run migrate",
    "db:truncate": "pnpm --filter @gbd/db run truncate",
    "db:gen-types": "pnpm --filter @gbd/db run gen-types"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "turbo": "2.10.8",
    "typescript": "catalog:"
  }
}
