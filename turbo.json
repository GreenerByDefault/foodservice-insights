{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json", ".nvmrc", "pnpm-workspace.yaml", ".env.test"],
  // Turborepo defaults to strict env mode, so a variable not named here is invisible to every
  // task. `globalEnv` is hashed as well as passed through — TEST_DB belongs there so a cached
  // result from one database can never be reused for the other.
  "globalEnv": ["TEST_DB"],
  "globalPassThroughEnv": ["PLAYWRIGHT_*", "DB_CONNECTION_STRING"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": ["build/**", ".svelte-kit/output/**"],
      "env": ["PUBLIC_*"]
    },
    "check": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:unit": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": ["playwright-report/**", "test-results/**"]
    }
  }
}
