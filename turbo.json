{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "globalDependencies": [
    "tsconfig.base.json",
    ".nvmrc",
    "pnpm-workspace.yaml",
    ".env.test",
    "contract/**"
  ],
  "globalEnv": ["TEST_DB"],
  "globalPassThroughEnv": [
    "PLAYWRIGHT_*",
    "DB_CONNECTION_STRING",
    "S3_ENDPOINT",
    "S3_REGION",
    "S3_ACCESS_KEY_ID",
    "S3_SECRET_ACCESS_KEY",
    "S3_BUCKET",
    "EMAIL_TRANSPORT",
    "EMAIL_ENDPOINT",
    "EMAIL_FROM_ADDRESS",
    "EMAIL_GBD_ADDRESS",
    "EMAIL_SUPPORT_ADDRESS",
    "SITE_URL",
    "REPORT_RATE_LIMIT",
    "WORKER_MODE",
    "WORKER_ID",
    "WORKER_RUN_ROOT",
    "WORKER_MAX_CONCURRENT_ATTEMPTS",
    "PYTHON_BIN",
    "OPENAI_API_KEY"
  ],
  "tasks": {
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": ["build/**", "dist/**", ".svelte-kit/output/**"],
      "env": ["PUBLIC_*"]
    },
    "check": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": []
    },
    "test:unit": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": []
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "test:screenshots": {
      "dependsOn": ["build"],
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "test:playwright": {
      "dependsOn": ["build"],
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "test:system": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/web/Dockerfile",
        "$TURBO_ROOT$/apps/worker/Dockerfile",
        "$TURBO_ROOT$/.dockerignore",
        "$TURBO_ROOT$/pyproject.toml",
        "$TURBO_ROOT$/uv.lock",
        "$TURBO_ROOT$/python/**",
        "!$TURBO_ROOT$/python/lab/**",
        "!$TURBO_ROOT$/python/**/__pycache__/**",
        "!$TURBO_ROOT$/python/**/*.md"
      ],
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "screenshots:update": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "migrate": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "seed:identity": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "truncate": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "gen-types": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "db:clean": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:browser:stop": {
      "cache": false
    }
  }
}
