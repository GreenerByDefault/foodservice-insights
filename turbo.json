{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "globalDependencies": [
    "tsconfig.base.json",
    ".nvmrc",
    "pnpm-workspace.yaml",
    ".env.test",
    "contract/**"
  ],
  "globalEnv": ["TEST_DB"],
  "globalPassThroughEnv": [
    "PLAYWRIGHT_*",
    "DB_CONNECTION_STRING",
    "S3_ENDPOINT",
    "S3_REGION",
    "S3_ACCESS_KEY_ID",
    "S3_SECRET_ACCESS_KEY",
    "S3_BUCKET",
    "EMAIL_TRANSPORT",
    "EMAIL_ENDPOINT",
    "EMAIL_FROM",
    "EMAIL_GBD_ADDRESS",
    "EMAIL_SUPPORT_ADDRESS",
    "SITE_URL"
  ],
  "tasks": {
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": ["build/**", "dist/**", ".svelte-kit/output/**"],
      "env": ["PUBLIC_*"]
    },
    "check": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:unit": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "migrate": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "seed": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "truncate": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "gen-types": {
      "dependsOn": ["^build"],
      "cache": false
    }
  }
}
