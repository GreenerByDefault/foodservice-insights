{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json", ".nvmrc", "pnpm-workspace.yaml", ".env.test"],
  "globalEnv": ["TEST_DB"],
  "globalPassThroughEnv": ["PLAYWRIGHT_*", "DB_CONNECTION_STRING"],
  "tasks": {
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": ["build/**", "dist/**", ".svelte-kit/output/**"],
      "env": ["PUBLIC_*"]
    },
    "check": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:unit": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "migrate": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "truncate": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "gen-types": {
      "dependsOn": ["^build"],
      "cache": false
    }
  }
}
