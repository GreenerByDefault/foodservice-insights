# The test stack, supabase-test/. Committed on purpose: every value is a local-only default
# that the Supabase CLI generates identically on every machine, so there is nothing to keep
# secret and nothing for a new contributor to fill in.
#
# Loaded when `TEST_DB` is set (Node scripts, via @gbd/core/env) and whenever Vite runs in
# test mode (vitest). Keep every port in sync with supabase-test/supabase/config.toml.

DB_CONNECTION_STRING=postgresql://postgres:postgres@127.0.0.1:65322/postgres
