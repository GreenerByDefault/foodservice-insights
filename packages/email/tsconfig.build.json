// Emits `dist/`, which is what `package.json`'s `exports` point at. `tsconfig.json` is
// still the config for typechecking, and covers the tests this one excludes — neither is
// importable from outside the package.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
