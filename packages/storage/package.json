{
  "name": "@gbd/storage",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./env": "./dist/env.js",
    "./testing": "./dist/testing/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "check": "tsc --noEmit",
    "test:unit": "TEST_DB=1 vitest run",
    "migrate": "node scripts/migrate.ts",
    "truncate": "node scripts/truncate.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/s3-request-presigner": "catalog:",
    "@gbd/core": "workspace:*",
    "@gbd/db": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
