{
  "name": "@gbd/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./env": "./dist/env.js",
    "./seed": "./dist/seed.js",
    "./testing": "./dist/testing/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "check": "tsc --noEmit",
    "test:unit": "TEST_DB=1 vitest run",
    "test": "pnpm run test:unit",
    "migrate": "node scripts/migrate.ts",
    "seed:identity": "node scripts/seed-identity.ts",
    "truncate": "node scripts/truncate.ts",
    "gen-types": "kanel && biome check --write src/generated && node scripts/dump-schema.ts && node scripts/dump-auth-schema.ts"
  },
  "dependencies": {
    "@gbd/core": "workspace:*",
    "kysely": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "kanel": "catalog:",
    "kanel-kysely": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
