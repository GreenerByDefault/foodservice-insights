{
  "name": "@gbd/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./env": "./dist/env.js",
    "./log": "./dist/log.js",
    "./testing": "./dist/testing.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
