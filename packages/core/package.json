    "test:unit": "vitest run",
    "test": "pnpm run test:unit"
  },
  "dependencies": {
    "pino": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "pino-pretty": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
