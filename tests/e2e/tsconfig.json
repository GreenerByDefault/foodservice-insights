{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],

    // Overrides the base's bundler settings, which would accept an extensionless relative
    // import that Node then rejects at runtime.
    "module": "nodenext",
    "moduleResolution": "nodenext"
  },
  "include": ["specs/**/*.ts", "scripts/**/*.ts", "playwright.config.ts"]
}
